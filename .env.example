# Kopiere diese Datei nach ".env" und trage die Werte ein.
# Alle drei Werte sind "oeffentliche" Kennungen: Sie stecken spaeter ohnehin in
# der ausgelieferten App. GEHEIME Schluessel (Supabase service_role,
# OneSignal REST-Key) gehoeren NIEMALS hierher - der REST-Key liegt im
# Supabase Vault.

# Supabase -> Project Settings -> API
QCLI_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
QCLI_SUPABASE_ANON_KEY=sb_publishable_...

# OneSignal -> Settings -> Keys & IDs (App ID). Leer lassen = App ohne Push.
QCLI_ONESIGNAL_APP_ID=
